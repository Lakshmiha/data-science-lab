import numpy as np

def get_matrix_input(name):
    print(f"Enter values for {name} (3x3 matrix):")
    matrix = []
    for i in range(3):
        row = input(f"Row {i+1} (space-separated): ").strip().split()
        matrix.append([int(x) for x in row])
    return np.array(matrix)

# Get user input
matrix1 = get_matrix_input("Matrix 1")
matrix2 = get_matrix_input("Matrix 2")

# Perform operations
print("\nMatrix 1:\n", matrix1)
print("Matrix 2:\n", matrix2)

print("\nMatrix 1 + Matrix 2:\n", np.add(matrix1, matrix2))
print("Matrix 1 - Matrix 2:\n", np.subtract(matrix1, matrix2))
print("Matrix 1 * Matrix 2:\n", np.matmul(matrix1, matrix2))
print("2 * Matrix 1:\n", 2 * matrix1)
print("Transpose of Matrix 1:\n", np.transpose(matrix1))
